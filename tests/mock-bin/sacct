#!/usr/bin/env bash
# Mock: MOCK_SACCT_EXIT makes every query fail with that code and MOCK_SACCT_ERR, by default a connection error;
# MOCK_SACCT_CPUSECONDS set but empty lists no jobs. MOCK_SACCT_WAIT holds the rows guard wait reads.
[ -z "${MOCK_SACCT_EXIT:-}" ] || { echo "${MOCK_SACCT_ERR:-sacct: error: Problem talking to the database: Connection refused}" >&2; exit "$MOCK_SACCT_EXIT"; }
if [[ "$*" == *JobID,State,ExitCode* ]]; then cat "${MOCK_SACCT_WAIT:-/dev/null}"
elif [[ "$*" == *JobID,JobName* ]]; then cat "${MOCK_SACCT_ROWS:-/dev/null}"
elif [[ "$*" == *JobName,CPUTimeRAW* ]]; then cat "${MOCK_SACCT_RUNROWS:-/dev/null}"
elif [[ "$*" == *JobName,State* ]]; then cat "${MOCK_SACCT_STATE:-/dev/null}"
else for s in ${MOCK_SACCT_CPUSECONDS-36000 72000}; do echo "$s"; done; fi
