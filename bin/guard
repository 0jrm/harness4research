#!/usr/bin/env bash
# usage: guard <survey|init|archive|doctor|config|review|merge|ship|enter|broker|preflight|ripples|manifest|fence|code|launch|atlas|needs-you|hooks|wait|version> [args...]
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
cmd=${1:-help}; shift || true
case $cmd in
  survey|init|archive|doctor|config|review|merge) exec bash "$here/lib/$cmd.sh" "$@" ;;
  ship) exec bash "$here/lib/batch.sh" ship "$@" ;;
  pr) exec bash "$here/lib/pr-open.sh" "$@" ;;
  enter) exec python3 "$here/lib/enter.py" "$@" ;;
  broker) exec python3 "$here/lib/broker_host.py" "$@" ;;
  atlas) exec python3 "$here/lib/atlas.py" "$@" ;;
  needs-you) exec python3 "$here/lib/needs_you.py" "$@" ;;
  hooks) exec python3 "$here/lib/hooks.py" "$@" ;;
  wait) exec python3 "$here/lib/wait.py" "$@" ;;
  preflight|ripples|manifest|fence|code|launch)
    # Run the enclosing project's protected guard/run, never this harness's copy. Online, it reads this clone at the pin.
    base=${HPC_GUARD_REF:-$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)}
    runner=$(git show "$base:guard/run" 2>/dev/null) || {
      echo "guard $cmd runs inside a guarded project, and $(pwd) has no guard/run on $base." >&2
      echo "Run guard init <repo> first. To try this harness's copy on its own: bash $here/lib/guard/$cmd.sh" >&2
      exit 2; }
    HPC_HARNESS=${HPC_HARNESS:-$here} exec bash -c "$runner" guard/run "$cmd" "$@" ;;
  version)
    # shellcheck source=lib/version.sh
    . "$here/lib/version.sh"
    # shellcheck source=lib/vendor.sh
    . "$here/lib/vendor.sh"
    echo "harness4research $(harness_release) schema $h_schema at $here, pstack $(git -C "$here/vendor/cursor-plugins" rev-parse --short HEAD 2>/dev/null || echo not-linked)"
    top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
    project_version "$top"
    [ $p_guarded = 1 ] || { echo "$top has no guard on $p_base"; exit 0; }
    echo "$(basename "$top") guard schema $p_schema, ${p_release:+release $p_release, }installed from ${p_from:-unknown}"
    clone=${HPC_HARNESS:-$here}
    case $p_mode in
      offline) echo "mode offline: harness $p_pin, from guard/harness-$p_pin.sh on $p_base" ;;
      online) problem=$(pin_problem "$clone" "$p_pin")
        echo "mode online: harness $p_pin, from the clone $clone${problem:+; $problem: $(pin_fix "$clone" "$p_pin")}" ;;
      bin) echo "mode none: no harness: pin on $p_base, so the scripts are guard/bin/ there" ;;
    esac
    case $(skew) in
      current) echo "current" ;;
      project-older) if [ -n "$p_release" ]; then echo "project older: guard init $top --update"
        else echo "project older, installed before release stamps; run guard init $top --update"; fi ;;
      harness-older) echo "harness older or on another branch: git -C $here pull" ;;
      unknown-install) echo "install commit unknown: guard init $top --update --force" ;;
    esac ;;
  *) cat <<'USAGE'
usage: guard <command> [args]

Project setup, run from your machine:
  survey <repo>       read-only inventory of branches, context files, stale docs, duplicates
  init <repo>         propose guard/ and its companions on a new branch and worktree
  init <repo> --update  refresh guard scripts in a project that already has guard/
  version             this harness's release and schema, and inside a project whether either side is behind
  archive <repo>      tag every remote branch before any cleanup
  doctor [repo]       read-only checklist of the Quickstart setup: ruleset, credentials, capped account, skills,
                      reviewer, merge policy, needs-you hook and open items
  atlas [repo]        read-only HTML chart of runs, ripples, cards, receipts and the drawer; --serve PORT|SOCKET serves it live

Agent sessions, on your machine or a login node:
  enter <dir> [--agent NAME] [--no-tty] -- <cmd...>
                      runs any agent in a sandbox holding <dir> and a home of its own, with no network, credential or
                      scheduler of yours; its only ways out are the broker's sockets. guard enter <dir> -- bash to look
  broker setup        once per host: the broker's state and signing key, the agent profiles in
                      ~/.config/guard/agents/, and a sandbox self-test
  broker status       whether the broker answers, its sessions, live jobs and recent refusals
  broker stop         stops the broker; every session's sockets then refuse
  wait <job_id|pid> | wait -- <cmd...>  [--timeout 5m]
                      blocks until the job changes state, the process exits or 5 minutes pass, then prints the last
                      20 lines of output and its status, or how long it has run and how to keep waiting or stop it

In any git repository, guarded or not:
  needs-you           list what only you can do, check, or approve; add, show, ack, done, dismiss manage the queue
  hooks install claude [--user|--project]  remind you and Claude Code of open needs-you items on every prompt
  config [list | get KEY | set KEY VALUE]  your reviewer and merge settings
  review <pr>         an independent reviewer judges the pull request against the brief, and may push small fixes
  review --batch      reviews every open pull request by tier: records without a model, small ones several to a
                      session, large ones one by one; new question cards and guard changes go to you
  merge <pr>          squash-merges the pull request if policy, credentials, ruleset, checks and review allow it,
                      and otherwise queues the merge for a human
  merge --batch       runs merge on every pull request approved at its head, and queues one item for the refusals
  pr open --title TITLE --request FILE --plan FILE --test CMD --body FILE [--item ID] [--scope FILE] [--base BRANCH]
                      writes the branch's brief from the user's words, pushes the branch, opens its pull request
  ship [--now]        review --batch, then merge --batch, at once when a records pull request is green, else once
                      review_batch_max pull requests wait or the oldest is ship_interval_hours old; until then it
                      refreshes the question card digest

Inside a guarded project, guard <command> runs the project's guard/run from the protected branch:
  preflight, ripples, manifest, fence, code
  launch, on a host the budget card's launch_hosts names
USAGE
     [ "$cmd" = help ] || exit 64 ;;
esac
