#!/usr/bin/env bash
# usage: guard <survey|init|archive|preflight|ripples|manifest|fence> [args...]
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
cmd=${1:-help}; shift || true
case $cmd in
  survey|init|archive) exec bash "$here/lib/$cmd.sh" "$@" ;;
  preflight|ripples|manifest|fence) exec bash "$here/templates/guard/bin/$cmd.sh" "$@" ;;
  version)
    # shellcheck source=lib/version.sh
    . "$here/lib/version.sh"
    echo "harness4research $(harness_release) schema $h_schema at $here, pstack $(git -C "$here/vendor/pstack" rev-parse --short HEAD 2>/dev/null || echo missing)"
    top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
    project_version "$top"
    [ $p_guarded = 1 ] || { echo "$top has no guard on $p_base"; exit 0; }
    echo "$(basename "$top") guard schema $p_schema, installed from ${p_from:-unknown}"
    case $(skew) in
      current) echo "current" ;;
      project-older) echo "project older: guard init $top --update" ;;
      harness-older) echo "harness older or on another branch: git -C $here pull" ;;
      unknown-install) echo "install commit unknown: guard init $top --update --force" ;;
    esac ;;
  *) cat <<'USAGE'
usage: guard <command> [args]

Project setup, run from your machine:
  survey <repo>       read-only inventory of branches, context files, stale docs, duplicates
  init <repo>         propose guard/ and its companions on a new branch and worktree
  init <repo> --update  refresh guard scripts in a project that already has guard/
  version             this harness's release and schema, and inside a project whether either side is behind
  archive <repo>      tag every remote branch before any cleanup

Inside a guarded project, prefer guard/run, which runs the protected branch's copy:
  preflight, ripples, manifest, fence
USAGE
     [ "$cmd" = help ] || exit 64 ;;
esac
